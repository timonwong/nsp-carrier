{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(deps)",
    ":semanticCommitScopeDisabled"
  ],
  "enabledManagers": ["mise", "gomod", "npm", "github-actions"],
  "schedule": ["every weekend"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "groupName": "Wails v3 beta",
      "matchDepNames": [
        "github.com/wailsapp/wails/v3",
        "@wailsio/runtime",
        "go:github.com/wailsapp/wails/v3/cmd/wails3"
      ],
      "ignoreUnstable": false
    },
    {
      "groupName": "mise toolchain",
      "matchManagers": ["mise"],
      "matchDepNames": ["go", "node", "pnpm"]
    },
    {
      "groupName": "mise toolchain",
      "matchManagers": ["npm"],
      "matchDepNames": ["pnpm"],
      "matchDepTypes": ["packageManager"]
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    }
  ]
}
