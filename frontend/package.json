{
  "name": "nsp-carrier-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:app && npm run check:node",
    "check:app": "svelte-check --tsconfig ./tsconfig.json",
    "check:node": "tsc --noEmit -p ./tsconfig.node.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:generated": "oxfmt wailsjs",
    "bindings:canonicalize": "node scripts/wails-bindings.ts canonicalize",
    "bindings:generate": "node scripts/wails-bindings.ts generate",
    "bindings:check": "node scripts/wails-bindings.ts check",
    "test": "vitest run"
  },
  "dependencies": {
    "@nanostores/i18n": "^1.3.3",
    "@nanostores/persistent": "^1.3.5",
    "nanostores": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "24.13.3",
    "jsdom": "^29.1.1",
    "oxfmt": "0.63.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.4.0",
    "typescript": "5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
